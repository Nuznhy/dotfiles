/* Generated by Quickshell. Colors only. */
* {
    background: #282828;
    foreground: #d5c4a1;
    background-color: #282828;
    text-color: #d5c4a1;
    bordercolor: #504945;
    separatorcolor: #504945;
    bg: #282828;
    cur: #504945;
    fgd: #d5c4a1;
    cmt: #665c54;
    cya: #8ec07c;
    grn: #83a598;
    ora: #fe8019;
    pur: #d3869b;
    red: #fb4934;
    yel: #fabd2f;
    normal-normal-background: #282828;
    normal-normal-foreground: #d5c4a1;
    normal-active-background: #3c3836;
    normal-active-foreground: #8ec07c;
    normal-urgent-background: #fb4934;
    normal-urgent-foreground: #000000;
    alternate-normal-background: #3c3836;
    alternate-normal-foreground: #d5c4a1;
    alternate-active-background: #3c3836;
    alternate-active-foreground: #8ec07c;
    alternate-urgent-background: #fb4934;
    alternate-urgent-foreground: #000000;
    selected-normal-background: #d3869b;
    selected-normal-foreground: #000000;
    selected-active-background: #d3869b;
    selected-active-foreground: #000000;
    selected-urgent-background: #fb4934;
    selected-urgent-foreground: #000000;
    normal-background: #282828;
    normal-foreground: #d5c4a1;
    active-background: #3c3836;
    active-foreground: #8ec07c;
    urgent-background: #fb4934;
    urgent-foreground: #000000;
    selected-background: #d3869b;
}
window, mainbox, listview { background-color: #282828; }
window, listview, message, sidebar { border-color: #504945; }
inputbar, message { background-color: #3c3836; text-color: #d5c4a1; }
textbox, button, case-indicator { background-color: transparent; text-color: #d5c4a1; }
entry { background-color: transparent; text-color: #d5c4a1; placeholder-color: #665c54; }
prompt, textbox-prompt-colon { background-color: transparent; text-color: #d3869b; }
num-filtered-rows, num-rows, textbox-num-sep { background-color: transparent; text-color: #bdae93; }
scrollbar { background-color: #3c3836; handle-color: #665c54; }
button selected { background-color: #d3869b; text-color: #000000; }
element-text, element-icon { background-color: inherit; text-color: inherit; }
element-text { highlight: bold underline; }
element normal.normal { background-color: #282828; text-color: #d5c4a1; }
element normal.active { background-color: #3c3836; text-color: #8ec07c; }
element normal.urgent { background-color: #fb4934; text-color: #000000; }
element alternate.normal { background-color: #3c3836; text-color: #d5c4a1; }
element alternate.active { background-color: #3c3836; text-color: #8ec07c; }
element alternate.urgent { background-color: #fb4934; text-color: #000000; }
element selected.normal { background-color: #d3869b; text-color: #000000; }
element selected.active { background-color: #d3869b; text-color: #000000; }
element selected.urgent { background-color: #fb4934; text-color: #000000; }
